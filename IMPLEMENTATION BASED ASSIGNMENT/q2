# Q2 - Evidence Registration and SHA-256

import hashlib
import os

# Create sample evidence file
filename = "evidence_sample.txt"

with open(filename, "w") as f:
    f.write("CSA61 Digital Forensic Evidence Sample")

# SHA-256 function
def sha256_file(path):
    h = hashlib.sha256()

    with open(path, "rb") as f:
        while True:
            data = f.read(65536)
            if not data:
                break
            h.update(data)

    return h.hexdigest()

# Evidence information
evidence_id = "EVD-001"
source = "WKSTN-14"
investigator = "A. Kumar"
storage = "Evidence Locker A"
date_time = "2026-03-11 09:15:00"

hash_value = sha256_file(filename)

print("=" * 60)
print("EVIDENCE REGISTRATION")
print("=" * 60)

print("Evidence ID       :", evidence_id)
print("Source            :", source)
print("Investigator      :", investigator)
print("Acquisition Time  :", date_time)
print("Storage Location  :", storage)
print("File              :", filename)
print("SHA-256 Hash      :", hash_value)

print("\nResult:")
print("Evidence registered successfully with SHA-256 hash.")